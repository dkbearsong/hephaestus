# Hephaestus Environment Variables

PORT=3001
PYTHON_PORT=8000
PYTHON_SERVICE_URL=http://localhost:8000

# PostgreSQL Configuration
DATABASE_URL=postgresql://dbearsong@localhost:5432/hephaestus
PGHOST=localhost
PGPORT=5432
PGDATABASE=hephaestus
PGUSER=dbearsong
PGPASSWORD=

# Jira Cloud API & Webhook Configuration
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@domain.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=DEV
JIRA_WEBHOOK_SECRET=hephaestus_webhook_secret_2026

# Optional LLM API Key (e.g. Gemini / OpenAI for small LLM parser or LangGraph)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Prompt Markdown & Staging Output Directory (default: staging)
# Can be a relative path (e.g., custom_prompts) or an absolute path (/path/to/dir)
PROMPT_OUTPUT_DIR=staging

